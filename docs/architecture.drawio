<mxfile host="app.diagrams.net" agent="asgard" version="24.7.17">
  <diagram id="asgard-hld" name="Asgard HLD">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="700" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title + legend -->
        <mxCell id="title" value="Asgard Platform System Architecture" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fontStyle=1;fillColor=#ffffff;strokeColor=#d6d6d6;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="340" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Solid arrows ①–④: saving a photo&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Dashed arrows ⑤–⑥: viewing a photo" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="14" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- ================= YOUR BROWSER ================= -->
        <mxCell id="g_client" value="🖥 YOUR BROWSER" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdf8ee;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="320" height="480" as="geometry" />
        </mxCell>
        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="30" height="56" as="geometry" />
        </mxCell>
        <mxCell id="web" value="&lt;b&gt;Web App&lt;/b&gt; (React)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Encrypts photos before upload,&lt;br&gt;decrypts them for viewing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="125" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="wallet" value="&lt;b&gt;Wallet&lt;/b&gt; (MetaMask)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Your identity: signs in&lt;br&gt;and approves transactions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="390" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ================= ASGARD SERVER ================= -->
        <mxCell id="g_server" value="⚙ ASGARD SERVER (DOCKER)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdf8ee;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="80" width="320" height="480" as="geometry" />
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API&lt;/b&gt; (Go)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Sign-in, uploads, search,&lt;br&gt;albums, sharing keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="125" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="indexer" value="&lt;b&gt;Indexer&lt;/b&gt; (Go)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Copies blockchain events&lt;br&gt;into the database&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="260" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Fast copy for listing and search:&lt;br&gt;photos, albums, tags, access&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="400" width="260" height="120" as="geometry" />
        </mxCell>

        <!-- ================= DECENTRALIZED NETWORK ================= -->
        <mxCell id="g_net" value="⬡ DECENTRALIZED NETWORK" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fdf8ee;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="80" width="330" height="480" as="geometry" />
        </mxCell>
        <mxCell id="ipfs" value="&lt;b&gt;IPFS&lt;/b&gt; (Pinata / Kubo)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Stores the encrypted photos&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="110" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="&lt;b&gt;Polygon blockchain&lt;/b&gt;&lt;br&gt;AsgardVault smart contract&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Who owns each photo,&lt;br&gt;who it's shared with&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.08;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1020" y="250" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Source of truth: if the server is lost,&lt;br&gt;the database is rebuilt from the blockchain." style="text;html=1;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="360" width="230" height="40" as="geometry" />
        </mxCell>

        <!-- ================= FLOWS ================= -->
        <mxCell id="e_use" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="user" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_sign" value="sign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=11;" edge="1" parent="1" source="web" target="wallet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="① upload encrypted photo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontStyle=1;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="web" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="② store, get content ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontStyle=1;exitX=1;exitY=0.5;entryX=0.07;entryY=0.5;entryPerimeter=0;" edge="1" parent="1" source="api" target="ipfs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="③ save content IDs to your wallet (1 transaction)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontStyle=1;exitX=0.5;exitY=1;entryX=0.88;entryY=1;" edge="1" parent="1" source="wallet" target="contract">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="210" y="610" /><mxPoint x="1240" y="610" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="④ events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=12;fontStyle=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="contract" target="indexer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4b" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=11;exitX=0.5;exitY=1;entryX=0.75;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="indexer" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_api_pg" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;startArrow=block;fontSize=11;exitX=0.15;exitY=1;entryX=0.15;entryY=0;entryPerimeter=0;" edge="1" parent="1" source="api" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="⑤ your photo list + keys" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;fontStyle=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="api" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="⑥ download encrypted photo, decrypt in browser" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;fontSize=12;fontStyle=1;exitX=0.85;exitY=0.2;exitPerimeter=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ipfs" target="web">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1252" y="64" /><mxPoint x="210" y="64" /></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
