# Only needed for Polygon Amoy mode (compose.amoy.yml) or deploying the contract to Amoy.
# Local `docker compose up` needs nothing from this file.

# Contract deployment (packages/contracts)
PRIVATE_KEY=
POLYGONSCAN_API_KEY=
AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Backend (Amoy mode)
CONTRACT_ADDRESS=
START_BLOCK=
PINATA_JWT=
GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
JWT_SECRET=
